DATABASE_URL=sqlite:///./data/metricairn.db
CORS_ORIGINS=http://localhost:5173
# Required before exposing provisioning to the internet. Empty permits local setup.
PROVISIONING_TOKEN=
# Disable on every worker except one; use a separate scheduler before scaling.
SCHEDULER_ENABLED=false
# Optional SQL generation. Explicit providers require LLM_MODEL and their key.
# auto preserves existing Anthropic-before-OpenAI selection; disabled uses no provider.
LLM_PROVIDER=auto
LLM_MODEL=
LLM_TIMEOUT_S=12
LLM_MAX_OUTPUT_TOKENS=4096
# Optional OpenAI/compatible reasoning control; leave empty for model defaults.
LLM_REASONING_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# google uses the native Gemini SDK.
GEMINI_API_KEY=
# openai_compatible uses these fields (e.g. Meta Muse); select the endpoint's API.
LLM_BASE_URL=
LLM_API=chat_completions
LLM_API_KEY=
# Legacy Anthropic model setting; LLM_MODEL takes precedence.
ASK_MODEL=claude-haiku-4-5
AGENTIC_SQL_ENABLED=true
AGENTIC_SQL_TIMEOUT_S=15
AGENTIC_SQL_ROW_CAP=200
# One operator-owned Stripe account per deployment in this version.
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
ALERTS_FROM_EMAIL=Metricairn <alerts@example.com>
